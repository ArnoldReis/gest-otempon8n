{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.org/it-operations/ai-response.schema.json",
  "title": "ai-response (synthetic blueprint)",
  "type": "object",
  "properties": {
    "answer": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "model",
        "deterministic_fallback"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "read_only": {
      "const": true
    }
  },
  "required": [
    "answer",
    "mode",
    "generated_at",
    "source_refs",
    "warnings",
    "read_only"
  ],
  "additionalProperties": false
}
