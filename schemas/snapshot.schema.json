{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.org/it-operations/snapshot.schema.json",
  "title": "snapshot (synthetic blueprint)",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "const": "read_only"
    },
    "source_health": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "ok",
          "partial",
          "error",
          "unverified"
        ]
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "open_tasks": {
          "type": "integer",
          "minimum": 0
        },
        "open_prs": {
          "type": "integer",
          "minimum": 0
        },
        "observed_errors": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "open_tasks",
        "open_prs",
        "observed_errors"
      ],
      "additionalProperties": false
    },
    "operational": {
      "$ref": "https://schemas.example.org/it-operations/operational-insight.schema.json"
    },
    "time_reporting": {
      "type": "object",
      "properties": {
        "clickup_tracked_ms": {
          "type": "integer",
          "minimum": 0
        },
        "auto_captured_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "auto_confirmed_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "auto_pending_sessions": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "clickup_tracked_ms",
        "auto_captured_seconds",
        "auto_confirmed_seconds",
        "auto_pending_sessions"
      ],
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "mode",
    "source_health",
    "metrics",
    "operational",
    "time_reporting",
    "limitations"
  ],
  "additionalProperties": false
}
